                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"handle\": \"<string>\",\n  \"items\": [\n    {\n      \"quantity\": \"<integer>\",\n      \"price\": \"<integer>\",\n      \"description\": \"<string>\"\n    }\n  ],\n  \"order_nsu\": \"<string>\",\n  \"redirect_url\": \"<uri>\",\n  \"webhook_url\": \"<uri>\",\n  \"customer\": {\n    \"name\": \"<string>\",\n    \"email\": \"<email>\",\n    \"phone_number\": \"<string>\"\n  },\n  \"address\": {\n    \"cep\": \"<string>\",\n    \"street\": \"<string>\",\n    \"neighborhood\": \"<string>\",\n    \"number\": \"<string>\",\n    \"complement\": \"<string>\"\n  }\n}",
